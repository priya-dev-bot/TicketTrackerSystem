# ===== Backend environment variables (PLACEHOLDERS ONLY - never commit real values) =====
# Copy this file to ".env" locally. On Render, set each one in the dashboard.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (hosted DB is mandatory for the assessment)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/instaport?retryWrites=true&w=majority

# Long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Exact frontend origin (no trailing slash). Comma-separate for several.
CLIENT_ORIGIN=http://localhost:5173

# Demo account setup for "npm run seed" (choose your own passwords, share privately)
SEED_CUSTOMER_EMAIL=customer@instaport.example
SEED_CUSTOMER_PASSWORD=choose-a-password
SEED_AGENT_EMAIL=agent@instaport.example
SEED_AGENT_PASSWORD=choose-a-password

# OPTIONAL: a second customer (not published) to demonstrate ownership protection in the video
SEED_CUSTOMER2_EMAIL=customer2@instaport.example
SEED_CUSTOMER2_PASSWORD=choose-a-password
