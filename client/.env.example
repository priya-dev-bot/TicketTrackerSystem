# ===== Frontend environment variables (PLACEHOLDERS ONLY) =====
# These are baked into the public JS bundle at build time, so NEVER put secrets here.
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Production (set in Vercel) must be the HTTPS URL of your hosted backend, e.g.:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
# VITE_SOCKET_URL=https://your-backend.onrender.com
